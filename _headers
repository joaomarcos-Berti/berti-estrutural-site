# Headers do Cloudflare Pages — Berti Estrutural
# Doc: https://developers.cloudflare.com/pages/configuration/headers/

# ---- Segurança aplicada a todo o site ----
/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  # 'wasm-unsafe-eval': habilita o WebAssembly do model-viewer (3D da home) sem liberar eval() de JS.
  # 'unsafe-inline': por causa dos scripts/estilos embutidos nas páginas geradas.
  # connect-src mantém api.github.com + *.githubusercontent + nominatim: o /admin (CMS em JS puro) os usa para ler/gravar conteúdo e geocodificar endereços.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' blob: https://unpkg.com https://ajax.googleapis.com https://www.gstatic.com; worker-src 'self' blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://unpkg.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https:; media-src 'self' https:; connect-src 'self' blob: data: https://api.github.com https://raw.githubusercontent.com https://*.githubusercontent.com https://unpkg.com https://ajax.googleapis.com https://www.gstatic.com https://nominatim.openstreetmap.org; frame-src https://www.youtube.com https://www.youtube-nocookie.com; object-src 'none'; base-uri 'self'; frame-ancestors 'self'

# ---- Assets públicos: liberar uso cross-origin (ex.: modelo 3D no protótipo/Designer) ----
# Nomes de arquivo são únicos (timestamp/hash) -> cache longo e imutável (visitas repetidas instantâneas)
/assets/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=31536000, immutable

# ---- Admin: nunca cachear (sempre código novo) ----
/admin/*
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

# ---- Conteúdo (JSON de obras/blog): nunca cachear ----
/content/*
  Cache-Control: no-cache, no-store, must-revalidate
